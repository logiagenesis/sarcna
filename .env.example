# ------------------------------------------------------------------
# SARCNA 2027 Convention — environment configuration
# Copy to .env (the installer writes this for you) and never commit it.
# ------------------------------------------------------------------

APP_NAME="SARCNA 2027 Convention"
APP_ENV=production          # local | staging | production
APP_DEBUG=false
APP_URL=https://sarcna.org.za
APP_TIMEZONE=Africa/Johannesburg
APP_KEY=                    # 32+ random chars, generated by the installer

# --- Database (cPanel > MySQL Databases) --------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_sarcna27
DB_USER=cpaneluser_sarcna
DB_PASS=
DB_CHARSET=utf8mb4

# --- PayFast ------------------------------------------------------
PAYFAST_MODE=sandbox        # sandbox | live
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=https://sarcna.org.za/payment/success
PAYFAST_CANCEL_URL=https://sarcna.org.za/payment/cancelled
PAYFAST_NOTIFY_URL=https://sarcna.org.za/payment/notify
# Testing only. Points the server-to-server notification check at a local stub
# so the payment pipeline can be audited without reaching PayFast.
# LEAVE THIS EMPTY IN PRODUCTION.
PAYFAST_VALIDATE_URL=

# --- Mail (cPanel mailbox SMTP is preferred) ----------------------
MAIL_DRIVER=smtp            # smtp | mail | log
MAIL_HOST=mail.sarcna.org.za
MAIL_PORT=587
MAIL_ENCRYPTION=tls         # tls | ssl | none
MAIL_USERNAME=no-reply@sarcna.org.za
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@sarcna.org.za
MAIL_FROM_NAME="SARCNA 2027 Convention"

# --- Analytics & Search Console -----------------------------------
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Contact ------------------------------------------------------
WHATSAPP_NUMBER=27000000000
CONTACT_EMAIL=info@sarcna.org.za

# --- Sessions & security ------------------------------------------
SESSION_NAME=sarcna_session
SESSION_LIFETIME=7200
SESSION_SECURE=true
BOOKING_HOLD_MINUTES=15
